{
  "server": {
    "port": 8080,
    "host": "0.0.0.0",
    "worker_threads": 4
  },
  "database": {
    "host": "localhost",
    "port": 3306,
    "user": "root",
    "password": "password",
    "dbname": "linux_learning_platform"
  },
  "jwt": {
    "secret": "linux_learning_platform_secret_key",
    "expiry_seconds": 86400,
    "refresh_expiry_seconds": 604800
  },
  "docker": {
    "socket": "/var/run/docker.sock",
    "base_port": 10000,
    "base_image_ubuntu": "ubuntu:latest",
    "base_image_centos": "centos:latest",
    "container_memory_limit": "512m",
    "container_cpu_limit": "1.0"
  },
  "storage": {
    "upload_dir": "/var/lib/linux_learning/uploads",
    "max_upload_size": 104857600
  },
  "logging": {
    "level": "info",
    "file": "/var/log/linux_learning/app.log",
    "max_size": 10485760,
    "max_files": 5
  }
}